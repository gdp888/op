---

<aside class="sidebar" aria-label="Tools navigation" data-accent={accentColor}>
  <div class="sidebar-header">
    <a href={getRelativeLocaleUrl(lang)} class="sidebar-logo">OPN Chat</a>
  </div>

  {tools.map((cat) => (
    <div class="sidebar-category">
      <h3 class="sidebar-cat-title">{t(cat.category)}</h3>
      {cat.items.map((item) => (
        <a
          href={getRelativeLocaleUrl(lang, item.slug)}
          class:list={['sidebar-link', { 'sidebar-link-active': item.slug === activeTool }]}
          data-accent={accentColor}
        >
          <Fragment set:html={icons[item.icon]} />
          {t(item.key)}
        </a>
      ))}
    </div>
  ))}
</aside>

<style>
  .sidebar {
    width: 220px;
    flex-shrink: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: sticky;
    top: 2rem;
    align-self: flex-start;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 4px;
  }

  .sidebar-header {
    padding: 0.5rem 1rem 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .sidebar-logo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .sidebar-logo:hover {
    color: var(--opn-primary);
  }

  .sidebar-category {
    padding: 0.5rem 0;
  }

  .sidebar-cat-title {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-secondary);
    padding: 0.25rem 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.15s;
    margin: 0.1rem 0.5rem;
    line-height: 1.3;
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background: var(--bg-input);
  }

  .sidebar-link-active {
    color: #25D366;
    background: rgba(37, 211, 102, 0.1);
    font-weight: 600;
  }

  .sidebar-link-active:hover {
    color: #25D366;
    background: rgba(37, 211, 102, 0.15);
  }

  /* Dynamic accent color override for active links */
  .sidebar[data-accent="#2AABEE"] .sidebar-link-active {
    color: #2AABEE;
    background: rgba(42, 171, 238, 0.1);
  }
  .sidebar[data-accent="#2AABEE"] .sidebar-link-active:hover {
    color: #2AABEE;
    background: rgba(42, 171, 238, 0.15);
  }

  .sidebar[data-accent="#7360F2"] .sidebar-link-active {
    color: #7360F2;
    background: rgba(115, 96, 242, 0.1);
  }
  .sidebar[data-accent="#7360F2"] .sidebar-link-active:hover {
    color: #7360F2;
    background: rgba(115, 96, 242, 0.15);
  }

  .sidebar[data-accent="#3A76F0"] .sidebar-link-active {
    color: #3A76F0;
    background: rgba(58, 118, 240, 0.1);
  }
  .sidebar[data-accent="#3A76F0"] .sidebar-link-active:hover {
    color: #3A76F0;
    background: rgba(58, 118, 240, 0.15);
  }

  :global(.sidebar-icon) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }
  }
</style>
